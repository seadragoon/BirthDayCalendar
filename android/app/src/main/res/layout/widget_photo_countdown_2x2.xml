<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 空状態（誕生日なし） -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="カウントダウン対象の\n誕生日がありません"
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- コンテンツエリア -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- 写真（丸型ビットマップが描画される） -->
        <ImageView
            android:id="@+id/widget_photo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/widget_photo_placeholder"
            android:contentDescription="誕生日写真"
            android:scaleType="centerCrop" />

        <!-- 名前 -->
        <TextView
            android:id="@+id/item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="名前"
            android:textColor="#212121"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 日付 -->
        <TextView
            android:id="@+id/item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10月15日"
            android:textColor="#757575"
            android:textSize="10sp" />

        <!-- カウントダウンバッジ -->
        <TextView
            android:id="@+id/item_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_chip_primary"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:paddingBottom="2dp"
            android:text="あと3日"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
