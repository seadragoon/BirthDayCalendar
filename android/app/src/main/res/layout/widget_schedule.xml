<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ヘッダーエリア -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_schedule_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📅 今日の予定"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_schedule_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BirthDay Calendar"
            android:textColor="#9E9E9E"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:background="#EEEEEE"
        android:contentDescription="@null" />

    <!-- 空状態（予定なし） -->
    <TextView
        android:id="@+id/widget_schedule_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="直近の予定はありません"
        android:textColor="#9E9E9E"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- コンテンツエリア -->
    <LinearLayout
        android:id="@+id/widget_schedule_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 予定1件目 -->
        <LinearLayout
            android:id="@+id/schedule_item1_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/schedule_item1_bar"
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="#7986CB"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/schedule_item1_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="予定タイトル"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/schedule_item1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="今日 10:00 - 11:30"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/schedule_divider1"
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:background="#F0F0F0"
            android:contentDescription="@null"
            android:visibility="gone" />

        <!-- 予定2件目 -->
        <LinearLayout
            android:id="@+id/schedule_item2_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/schedule_item2_bar"
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="#7986CB"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/schedule_item2_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="予定タイトル"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/schedule_item2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="今日 14:00 - 15:00"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/schedule_divider2"
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:background="#F0F0F0"
            android:contentDescription="@null"
            android:visibility="gone" />

        <!-- 予定3件目 -->
        <LinearLayout
            android:id="@+id/schedule_item3_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/schedule_item3_bar"
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="#7986CB"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/schedule_item3_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="予定タイトル"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/schedule_item3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="明日 終日"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/schedule_divider3"
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:background="#F0F0F0"
            android:contentDescription="@null"
            android:visibility="gone" />

        <!-- 予定4件目 -->
        <LinearLayout
            android:id="@+id/schedule_item4_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/schedule_item4_bar"
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="#7986CB"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/schedule_item4_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="予定タイトル"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/schedule_item4_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9/8(火) 19:00 - 21:00"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
